<!DOCTYPE html>
<html lang="en">
{% if layout == "base" and date %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.url }}/#organization",
        "name": "{{ site.title }}",
        "url": "{{ site.url }}"
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}",
        "name": "{{ site.title }}",
        "publisher": { "@id": "{{ site.url }}/#organization" }
      },
      {
        "@type": "Article",
        "@id": "{{ site.url }}{{ page.url }}#article",
        "headline": "{{ title | escape }}",
        "description": "{{ description | escape }}",
        "url": "{{ site.url }}{{ page.url }}",
        "datePublished": "{{ date | htmlDateString }}",
        "dateModified": "{{ date | htmlDateString }}",
        "author": {
          "@type": "Person",
          "name": "{{ author }}",
          "url": "{{ site.url }}/about/"
        },
        "publisher": { "@id": "{{ site.url }}/#organization" },
        "inLanguage": "en-US",
        "isPartOf": { "@id": "{{ site.url }}/#website" }
      }
    ]
  }
  </script>
  {% endif %}

<head>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NX57V748');</script>
  <!-- End Google Tag Manager -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or site.description }}">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,400;0,600;1,400&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="verification" content="3f3ab1d880b26567e6e7a6f90df1e14c" />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NX57V748"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <header class="site-header">
    <div class="header-inner">
      <div class="site-brand">
        <a href="/" class="brand-link">
          <span class="brand-icon">☕</span>
          <div class="brand-text">
            <span class="brand-name">The Coffee Can Camp</span>
            <span class="brand-tagline">Gear advice. Trail stories. Hard-won opinions.</span>
          </div>
        </a>
      </div>
      <nav class="site-nav">
        {% for item in site.nav %}
          <a href="{{ item.url }}" class="nav-link {% if page.url == item.url %}active{% endif %}">{{ item.text }}</a>
        {% endfor %}
      </nav>
      <button class="nav-toggle" aria-label="Toggle navigation">☰</button>
    </div>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="brand-icon">☕</span>
        <span>The Coffee Can Camp</span>
      </div>
      <p class="footer-bio">{{ site.author.bio }}</p>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href="/stories/">Stories</a>
        <a href="/gear/">Gear</a>
        <a href="/feed.xml">RSS</a>
        <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-service/">Terms of Service</a>
      </div>
      <p class="footer-copy">© {{ site.currentYear }} TheCoffeeCanCamp.com · Built on campfire logic and hard experience.<br>
      <small>Some links on this site are affiliate links. If you buy something through them I earn a small commission at no extra cost to you. See our <a href="/affiliate-disclosure/">Affiliate Disclosure</a> for full details.</small></p>
    </div>
  </footer>

  <script>
    // Mobile nav toggle
    const toggle = document.querySelector('.nav-toggle');
    const nav = document.querySelector('.site-nav');
    if (toggle) {
      toggle.addEventListener('click', () => nav.classList.toggle('open'));
    }
  </script>

</body>
</html>